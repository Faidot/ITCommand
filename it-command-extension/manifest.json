{
  "manifest_version": 3,
  "name": "IT Command",
  "version": "0.1.0",
  "description": "Auto-fill passwords from your IT Command vault. (Passwords for now; more modules to come.)",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://192.168.62.83:8000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IT Command"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
