# ---- TeraMailer backend environment ----

# HTTP server
PORT=5000
NODE_ENV=development

# Session
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-this-to-a-long-random-string

# Redis (optional). If unreachable, the server falls back to an in-memory
# session store automatically (fine for development, not for production).
REDIS_URL=redis://localhost:6379

# Comma separated list of allowed CORS origins (the webmail + admin dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# First-run admin bootstrap. On startup, if no admin password hash exists in
# settings.json it is created from this value (default username: admin).
ADMIN_DEFAULT_PASSWORD=admin123

# Cookie hardening. In production force this to "true" (requires HTTPS).
# Leave false for local http development or the session cookie won't be set.
COOKIE_SECURE=false

# Max attachment upload size in megabytes
MAX_UPLOAD_MB=25
