# ─── Terafort Mail ─────────────────────────────────────────────────────────
# Copy to .env and fill in. Three of these must be IDENTICAL in IT Command's
# .env or the handoff fails closed:
#   MAIL_SESSION_SEAL_KEY, MAIL_HANDOFF_HMAC_KEY, MAIL_INTERNAL_HMAC_KEY

DEBUG=false
SECRET_KEY=                       # python -c "import secrets;print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=mail.itcommand.com
MAIL_HTTP_PORT=8080

# ─── database ──────────────────────────────────────────────────────────────
DB_NAME=terafort_mail
DB_USER=tfmail                    # NOT a superuser: RLS is bypassed by one
DB_PASSWORD=
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=

# ─── redis (session store) ─────────────────────────────────────────────────
REDIS_PASSWORD=
MAIL_REDIS_URL=redis://:PASSWORD@mail-redis:6379/0

# ─── shared secrets ────────────────────────────────────────────────────────
# Seals session records before they reach Redis. EXACTLY 32 bytes.
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
MAIL_SESSION_SEAL_KEY=
# Signs handoff tickets.  python -c "import secrets;print(secrets.token_urlsafe(48))"
MAIL_HANDOFF_HMAC_KEY=
# Signs service-to-service requests. Distinct from the handoff key so a leak
# of one does not compromise the other.
MAIL_INTERNAL_HMAC_KEY=
MAIL_INTERNAL_SERVICES=itcommand

# ─── dovecot / exim ────────────────────────────────────────────────────────
MAIL_IMAP_HOST=mail.yourcpanelhost.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true
MAIL_IMAP_VERIFY_CERT=true        # false only for a self-signed cert; logs a warning
MAIL_IMAP_TIMEOUT=15
MAIL_SMTP_PORT=587
MAIL_SMTP_STARTTLS=true

# ─── session timers (blueprint: 8h absolute, 1h idle) ──────────────────────
MAIL_SESSION_ABSOLUTE_SECONDS=28800
MAIL_SESSION_IDLE_SECONDS=3600
MAIL_MFA_TICKET_SECONDS=180
MAIL_HANDOFF_TICKET_SECONDS=30

# ─── behaviour ─────────────────────────────────────────────────────────────
# Off means the handoff from IT Command is the only way in: one front door,
# one TOTP enrolment. Turn on only if you want mail usable when IT Command is down.
MAIL_DIRECT_LOGIN_ENABLED=false
# Bind handoff tickets to the client IP. Leave off until you have confirmed
# X-Forwarded-For is trustworthy end to end; mobile users change address.
MAIL_HANDOFF_BIND_IP=false
MAIL_COOKIE_SECURE=true
ITC_BASE_URL=https://itcommand.com

# Shared secret for the read-only IMAP capability probe. Leave blank to
# disable the endpoint entirely.
MAIL_PROBE_TOKEN=
