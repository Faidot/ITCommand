# =============================================================================
# ITCommand — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" in the same folder and fill in the values:
#
#     cp .env.example .env
#
# docker-compose.yml reads this single file for the whole stack
# (database, backend, frontend, nginx). Never commit your real .env.
# =============================================================================

# ----- Public entry point ----------------------------------------------------
# Host port nginx listens on. Use 80 for normal HTTP.
HTTP_PORT=80

# ----- Django core -----------------------------------------------------------
# Generate a new secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value

# Must be False in production.
DEBUG=False

# IANA timezone used by daily/monthly automation (e.g. UTC, Asia/Karachi).
TIME_ZONE=UTC

# Comma-separated hosts/domains/IPs this site may serve. Add your server's
# public IP and/or domain. Example: localhost,127.0.0.1,203.0.113.10,itcommand.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Required for the Django admin login when DEBUG=False and served over a domain.
# Comma-separated, WITH scheme. Example: http://203.0.113.10,https://itcommand.example.com
CSRF_TRUSTED_ORIGINS=

# Only needed if the frontend is served from a DIFFERENT origin than the API.
# With the default nginx single-origin setup you can leave this as-is.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# HTTPS hardening. Keep these disabled for plain-HTTP local development. After
# putting the stack behind HTTPS, enable the three booleans and set HSTS only
# after verifying every intended subdomain is HTTPS-only.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Signed upload links expire after this many seconds. Docker should delegate
# validated downloads to nginx; local runserver should stream them itself.
PROTECTED_MEDIA_URL_TTL=3600
PROTECTED_MEDIA_USE_X_ACCEL=True

# Fernet key used to encrypt vault secrets. REQUIRED.
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: keep this safe and NEVER change it after data has been saved, or
# previously encrypted vault entries become unreadable.
VAULT_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# ----- Database (PostgreSQL) -------------------------------------------------
# These create the Postgres container AND tell Django how to connect.
# (DB_HOST/DB_PORT are set automatically by docker-compose to the "db" service.)
DB_NAME=itcommand
DB_USER=itcommand
DB_PASSWORD=CHANGE_ME_strong_db_password

# ----- Backend (Gunicorn) ----------------------------------------------------
# Number of worker processes. A good starting point is (2 x CPU cores) + 1.
GUNICORN_WORKERS=3
# Maximum seconds a backend request may run before Gunicorn aborts it.
GUNICORN_TIMEOUT=120

# ----- Automation ------------------------------------------------------------
# The Docker automation service runs these commands once per local calendar day.
# Phase 5 removed auto_renew_licenses, auto_renew_subscriptions,
# check_license_alerts and check_subscription_alerts along with the modules
# they served. `run_automation` skips a command that no longer exists, so an
# older .env still naming them is harmless — but it should be tidied.
AUTOMATION_DAILY_COMMANDS=finance_autopost,fetch_exchange_rates,sync_brex,check_contract_alerts
# Commands to run on a short cadence instead of once a day. Empty today: the
# estate has no alerting pipeline of its own yet.
AUTOMATION_INTERVAL_COMMANDS=
AUTOMATION_INTERVAL_SECONDS=300
AUTOMATION_POLL_SECONDS=60
AUTOMATION_RETRY_SECONDS=300

# Network-device reachability checks. The backend image includes `ping`.
AUTOMATION_PING_ENABLED=True
PING_CHECK_INTERVAL_SECONDS=300

# Monthly finance email is opt-in. When enabled, a missed report day is caught
# up after the service restarts. FINANCE_REPORT_DAY is clamped to 1..28.
AUTOMATION_EMAIL_REPORT_ENABLED=False
FINANCE_REPORT_DAY=1

# ----- Email -----------------------------------------------------------------
# Local manual development defaults to Django's console backend when DEBUG=True.
# Production defaults to SMTP. Configure these before enabling monthly reports.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=itcommand@example.com

# ----- Frontend (Next.js) ----------------------------------------------------
# API base URL baked into the browser bundle at build time. Leave as "/api" so
# the frontend calls the same origin (nginx routes /api to the backend). Only
# change this if you serve the API on a separate domain.
NEXT_PUBLIC_API_URL=/api
